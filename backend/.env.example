# RipetiFlow backend — copy to `.env` (never commit it). Variables are documented in docs/03 and
# docs/09. Optional secrets: leave them commented out (or unset); an empty value means "not set".

# --- Runtime ------------------------------------------------------------------------------------
# Without APP_ENV=development the app runs as production (no /api/docs, no demo routes).
APP_ENV=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------------------------
# Local: the Postgres used by the tests (shim + migrations), see backend/README.md.
# Production: Supabase "Session pooler" URL (port 5432), user postgres.<project-ref>.
DATABASE_URL=postgresql://postgres@localhost:54329/ripetiflow
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# --- Supabase Auth ----------------------------------------------------------------------------------
SUPABASE_URL=https://afaowzrghvqnqcovxtqu.supabase.co
# Publishable key (sb_publishable_...): Supabase -> Project Settings -> API Keys. Served to the SPA.
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_LOGIN_ENABLED=true
MAGIC_LINK_ENABLED=true
PUBLIC_APP_URL=http://localhost:5173
# Built SPA served by FastAPI (production image sets it to /srv/static).
# STATIC_DIR=../frontend/dist

# --- Demo mode (D-30) ----------------------------------------------------------------------------
# Only with APP_ENV=development AND a local DATABASE_URL. Enables POST /api/v1/dev/login and /dev/seed.
DEV_AUTH=1
# DEV_JWT_SECRET=change-me-for-shared-dev-machines

# --- Google Calendar sync (D-31, docs/08) -------------------------------------------------------
# All three are required to enable the sync; otherwise /public/config says calendar_sync_available=false.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: losing it means every tutor must reconnect Google Calendar.
# TOKEN_ENCRYPTION_KEY=
# CALENDAR_WORKER_ENABLED=true
# CALENDAR_WORKER_INTERVAL_SECONDS=10

# --- Matita assistant (D-40..D-42, docs/06) -------------------------------------------------------
# openai (default, model gpt-6-luna) | anthropic | none
ASSISTANT_PROVIDER=openai
# ASSISTANT_MODEL=gpt-6-luna
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ASSISTANT_DAILY_LIMIT=60
# ASSISTANT_TIMEOUT_SECONDS=45
